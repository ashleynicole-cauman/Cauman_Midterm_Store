@model Cauman_Midterm_Store.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>

<div class="row">

    <div class="col-md-6">

        <form asp-action="Edit" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="mb-3">

                <label asp-for="Name"
                       class="form-label">
                    Product Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Description"
                       class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"></textarea>

            </div>

            <div class="mb-3">

                <label asp-for="Price"
                       class="form-label">
                    Price
                </label>

                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       step="0.01" />

            </div>

            <div class="mb-3">

                <label asp-for="Category"
                       class="form-label">
                    Category
                </label>

                <input asp-for="Category"
                       class="form-control" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>