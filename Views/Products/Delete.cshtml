@model Cauman_Midterm_Store.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this product?
</div>

<div class="card mb-3">

    <div class="card-body">

        <h5 class="card-title">
            @Model.Name
        </h5>

        <p class="card-text">
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p class="card-text">
            <strong>Price:</strong>
            ₱@Model.Price.ToString("N2")
        </p>

        <p class="card-text">
            <strong>Category:</strong>
            @Model.Category
        </p>

    </div>

</div>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>